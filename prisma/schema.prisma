generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model roles {
  id               String             @id @default(uuid())
  name             String             @unique
  role_permissions role_permissions[]
  users            users[]
}

model permissions {
  id               String             @id @default(uuid())
  name             String             @unique
  role_permissions role_permissions[]
}

model role_permissions {
  id           String      @id @default(uuid())
  roleId       String      @map("role_id")
  permissionId String      @map("permission_id")
  permission   permissions @relation(fields: [permissionId], references: [id])
  role         roles       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model users {
  id             String           @id @default(uuid())
  roleId         String           @map("role_id")
  firstName      String           @map("first_name")
  lastName       String           @map("last_name")
  email          String           @unique
  phoneNumber    String           @map("phone_number")
  isVerified     Boolean          @default(false) @map("is_verified")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  password       String
  bookings       bookings[]
  bus_operators  bus_operators[]
  crews          crews[]
  reviews        reviews[]
  seat_inventory seat_inventory[]
  role           roles            @relation(fields: [roleId], references: [id])
}

model bus_operators {
  id                    String                  @id @default(uuid())
  name                  String
  gstNumber             String                  @unique @map("gst_number")
  email                 String                  @unique
  phoneNumber           String                  @map("phone_number")
  ownerUserId           String                  @map("owner_user_id")
  isActive              Boolean                 @default(true) @map("is_active")
  createdAt             DateTime                @default(now()) @map("created_at")
  isPrivate             Boolean                 @default(true) @map("is_private")
  owner                 users                   @relation(fields: [ownerUserId], references: [id])
  buses                 buses[]
  cancellation_policies cancellation_policies[]
  crews                 crews[]
}

model crews {
  id               String        @id @default(uuid())
  role             crew_type
  userId           String        @map("user_id")
  operatorId       String        @map("operator_id")
  licenseNumber    String        @unique @map("license_number")
  licenseExpiry    DateTime      @map("license_expiry")
  emergencyContact String        @map("emergency_contact")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  bus_operator     bus_operators @relation(fields: [operatorId], references: [id])
  user             users         @relation(fields: [userId], references: [id])
  conductor        trips[]       @relation("Conductor")
  driver           trips[]       @relation("Driver")

  @@unique([userId, operatorId, role])
}

model buses {
  id                 String         @id @default(uuid())
  operatorId         String         @map("operator_id")
  vehicleNumber      String         @unique @map("vehicle_number")
  registrationNumber String         @unique @map("registration_number")
  type               bus_type
  totalSeats         Int            @map("total_seats")
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  bus_operator       bus_operators  @relation(fields: [operatorId], references: [id])
  seat_configs       seat_configs[]
  trips              trips[]
}

model seat_configs {
  id             String           @id @default(uuid())
  busId          String           @map("bus_id")
  seatNumber     String           @map("seat_number")
  seatType       seat_type        @map("seat_type")
  deck           deck
  isWindow       Boolean          @map("is_window")
  isLadiesSeat   Boolean          @map("is_ladies_seat")
  bus            buses            @relation(fields: [busId], references: [id])
  seat_inventory seat_inventory[]

  @@unique([busId, seatNumber])
}

model locations {
  id                  String        @id @default(uuid())
  name                String
  latitude            Float
  longitude           Float
  bookings_as_dropoff bookings[]    @relation("BookingDropoffLocation")
  bookings_as_pickup  bookings[]    @relation("BookingPickupLocation")
  route_stops         route_stops[]
  destination_routes  routes[]      @relation("Destination")
  source_routes       routes[]      @relation("Source")

  @@unique([name, latitude, longitude])
}

model routes {
  id                       String        @id @default(uuid())
  sourceId                 String        @map("source_id")
  destinationId            String        @map("destination_id")
  distanceKm               Float         @map("distance_km")
  estimatedDurationMinutes Int           @map("estimated_duration_minutes")
  isActive                 Boolean       @default(true) @map("is_active")
  route_stops              route_stops[]
  destination              locations     @relation("Destination", fields: [destinationId], references: [id])
  source                   locations     @relation("Source", fields: [sourceId], references: [id])
  trip_fares               trip_fares[]
  trips                    trips[]

  @@unique([sourceId, destinationId])
}

model route_stops {
  id         String    @id @default(uuid())
  routeId    String    @map("route_id")
  locationId String    @map("location_id")
  stopOrder  Int       @map("stop_order")
  location   locations @relation(fields: [locationId], references: [id])
  route      routes    @relation(fields: [routeId], references: [id])

  @@unique([routeId, locationId])
  @@unique([routeId, stopOrder])
}

model trips {
  id                    String                 @id @default(uuid())
  tripCode              String                 @unique @map("trip_code")
  routeId               String                 @map("route_id")
  busId                 String                 @map("bus_id")
  driverId              String                 @map("driver_id")
  conductorId           String                 @map("conductor_id")
  departureTime         DateTime               @map("departure_time")
  arrivalTime           DateTime               @map("arrival_time")
  availableSeats        Int                    @map("available_seats")
  status                trip_status            @default(scheduled)
  cancellationReason    String?                @map("cancellation_reason")
  startedAt             DateTime?              @map("started_at")
  completedAt           DateTime?              @map("completed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  bookings              bookings[]
  current_bus_locations current_bus_locations?
  reviews               reviews[]
  seat_inventory        seat_inventory[]
  trip_fares            trip_fares[]
  bus                   buses                  @relation(fields: [busId], references: [id])
  conductor             crews                  @relation("Conductor", fields: [conductorId], references: [id])
  driver                crews                  @relation("Driver", fields: [driverId], references: [id])
  route                 routes                 @relation(fields: [routeId], references: [id])

  @@unique([routeId, busId, departureTime])
}

model trip_fares {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  routeId   String   @map("route_id")
  price     Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  route     routes   @relation(fields: [routeId], references: [id])
  trip      trips    @relation(fields: [tripId], references: [id])

  @@unique([tripId, routeId])
}

model seat_inventory {
  id             String         @id @default(uuid())
  tripId         String         @map("trip_id")
  busSeatId      String         @map("bus_seat_id")
  price          Float
  status         seat_status    @default(available)
  lockedBy       String?        @map("locked_by")
  lockedUntil    DateTime?      @map("locked_until")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  booking_seats  booking_seats?
  bus_seat       seat_configs   @relation(fields: [busSeatId], references: [id])
  locked_by_user users?         @relation(fields: [lockedBy], references: [id])
  trip           trips          @relation(fields: [tripId], references: [id])

  @@unique([tripId, busSeatId])
}

model bookings {
  id                 String               @id @default(uuid())
  userId             String               @map("user_id")
  tripId             String               @map("trip_id")
  pickupStopId       String               @map("pickup_stop_id")
  dropoffStopId      String               @map("dropoff_stop_id")
  totalSeats         Int                  @map("total_seats")
  totalAmount        Float                @map("total_amount")
  status             booking_status
  cancellationReason String               @map("cancellation_reason")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  tickets            Tickets?
  booking_passengers booking_passengers[]
  booking_seats      booking_seats[]
  dropoff_location   locations            @relation("BookingDropoffLocation", fields: [dropoffStopId], references: [id])
  pickup_location    locations            @relation("BookingPickupLocation", fields: [pickupStopId], references: [id])
  trip               trips                @relation(fields: [tripId], references: [id])
  user               users                @relation(fields: [userId], references: [id])
  payments           payments[]
  refunds            refunds[]
  reviews            reviews?
}

model booking_seats {
  id                 String              @id @default(uuid())
  bookingId          String              @map("booking_id")
  seatInventoryId    String              @unique @map("seat_inventory_id")
  fare               Float
  booking_passengers booking_passengers?
  booking            bookings            @relation(fields: [bookingId], references: [id])
  seat_inventory     seat_inventory      @relation(fields: [seatInventoryId], references: [id])

  @@unique([bookingId, seatInventoryId])
}

model booking_passengers {
  id             String        @id @default(uuid())
  bookingId      String        @map("booking_id")
  bookingSeatsId String        @unique @map("booking_seats_id")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  age            Int
  gender         String
  booking        bookings      @relation(fields: [bookingId], references: [id])
  booking_seats  booking_seats @relation(fields: [bookingSeatsId], references: [id])
}

model payment_modes {
  id       String     @id @default(uuid())
  name     String     @unique
  isActive Boolean    @default(true) @map("is_active")
  payments payments[]
}

model payments {
  id                String         @id @default(uuid())
  bookingId         String         @map("booking_id")
  paymentModeId     String         @map("payment_mode_id")
  providerOrderId   String         @unique @map("provider_order_id")
  providerPaymentId String?        @unique @map("provider_payment_id")
  amount            Float
  failureReason     String?        @map("failure_reason")
  status            payment_status
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  booking           bookings       @relation(fields: [bookingId], references: [id])
  payment_mode      payment_modes  @relation(fields: [paymentModeId], references: [id])
  refunds           refunds[]
}

model refunds {
  id               String        @id @default(uuid())
  bookingId        String        @map("booking_id")
  paymentId        String        @map("payment_id")
  providerRefundId String?       @unique @map("provider_refund_id")
  amount           Float
  reason           String?
  status           refund_status
  createdAt        DateTime      @default(now()) @map("created_at")
  booking          bookings      @relation(fields: [bookingId], references: [id])
  payment          payments      @relation(fields: [paymentId], references: [id])
}

model cancellation_policies {
  id                   String        @id @default(uuid())
  operatorId           String        @map("operator_id")
  hoursBeforeDeparture Int           @map("hours_before_departure")
  refundPercentage     Int           @map("refund_percentage")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  bus_operators        bus_operators @relation(fields: [operatorId], references: [id])

  @@unique([operatorId, hoursBeforeDeparture])
}

model Tickets {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  pdfUrl    String   @map("pdf_url")
  issuedAt  DateTime @default(now()) @map("issued_at")
  booking   bookings @relation(fields: [bookingId], references: [id])
}

model current_bus_locations {
  tripId    String   @id @default(uuid()) @map("trip_id")
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  trip      trips    @relation(fields: [tripId], references: [id])
}

model reviews {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  userId    String   @map("user_id")
  tripId    String   @map("trip_id")
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  booking   bookings @relation(fields: [bookingId], references: [id])
  trip      trips    @relation(fields: [tripId], references: [id])
  user      users    @relation(fields: [userId], references: [id])
}

enum crew_type {
  driver
  conductor
}

enum bus_type {
  ac
  non_ac
}

enum seat_type {
  seater
  sleeper
}

enum deck {
  upper
  lower
}

enum trip_status {
  scheduled
  boarding
  completed
  cancelled
  delayed
  rescheduled
}

enum seat_status {
  available
  booked
  locked
}

enum booking_status {
  pending_payment
  confirmed
  cancelled
  failed
}

enum payment_status {
  pending
  success
  failed
  refunded
}

enum refund_status {
  pending
  processing
  success
  failed
}

enum auth_provider {
  google
  phone
}
